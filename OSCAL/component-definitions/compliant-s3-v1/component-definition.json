{
  "component-definition": {
    "uuid": "884d1a50-6a10-4497-a1cb-8a475d691f9b",
    "metadata": {
      "title": "Acme Health Patient Intake API Baseline",
      "last-modified": "2026-06-23T12:59:00.000000+00:00",
      "version": "1.0.0",
      "oscal-version": "1.1.3",
      "parties": [
        {
          "uuid": "1a1a7fa2-2ed8-47ec-a4ec-1e247ef0e816",
          "type": "organization",
          "name": "Acme Health (Benjamin S. Hobbs, GRC Engineering)"
        }
      ]
    },
    "components": [
      {
        "uuid": "cdb12590-4c46-4e50-a931-18e47db552a4",
        "type": "system",
        "title": "Patient Intake API Governance Baseline",
        "description": "Terraform baseline establishing audit-defensible guardrails around the Patient Intake API workload. Enforces encryption at rest, secure transport, versioning, network isolation, and least-privilege IAM.",
        "purpose": "Satisfy HIPAA Security Rule technical safeguards for PHI handled by the Patient Intake API.",
        "responsible-roles": [
          {
            "role-id": "provider",
            "party-uuids": [
              "1a1a7fa2-2ed8-47ec-a4ec-1e247ef0e816"
            ]
          }
        ],
        "control-implementations": [
          {
            "uuid": "2351ab6f-cd1e-4581-9b19-ef8a11bc1ea9",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/main/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "description": "Implementation of NIST 800-66 r2 (HIPAA Security Rule) controls satisfied by this Terraform module.",
            "implemented-requirements": [
              {
                "uuid": "072049d5-1c39-49ea-b9af-5c207d1a2936",
                "control-id": "hipaa-164.312.a.2.iv",
                "description": "Encryption and Decryption: Data at rest is encrypted using a customer-managed KMS key. This is enforced on both the S3 evidence vault and uploads bucket, as well as the DynamoDB intake table.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_s3_bucket_server_side_encryption_configuration.vault"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_s3_bucket_server_side_encryption_configuration.uploads"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_dynamodb_table.intake"
                  }
                ],
                "links": [
                  {
                    "rel": "evidence",
                    "href": "s3://acme-api-capstone-dev-grc-evidence-vault-1fe4ddb8/runs/LATEST/evidence-LATEST.tar.gz",
                    "text": "Signed pipeline bundle verifying KMS CMK attachment to storage resources."
                  },
                  {
                    "rel": "reference",
                    "href": "https://github.com/benjamin-s-hobbs/GRCEportfolio/terraform/main.tf",
                    "text": "Source Terraform for this module."
                  }
                ]
              },
              {
                "uuid": "d3b8ab0a-521b-4177-8fa0-fb97ea68377f",
                "control-id": "hipaa-164.312.e.1",
                "description": "Transmission Security: aws:SecureTransport is strictly enforced across the vault, uploads, and log buckets to guarantee TLS encryption in transit. Furthermore, compute resources (Lambda) are isolated within a private subnet of a customer-owned VPC.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_s3_bucket_policy.vault"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_s3_bucket_policy.uploads"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_lambda_function.intake"
                  }
                ]
              },
              {
                "uuid": "bb1a7298-b80c-4ddf-9989-10e30325f448",
                "control-id": "hipaa-164.308.a.7",
                "description": "Contingency Plan: S3 Object Versioning is explicitly enabled on the PHI uploads bucket and the compliance vault to prevent destructive overwrites and ensure data recoverability.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_s3_bucket_versioning.uploads"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_s3_bucket_versioning.vault"
                  }
                ]
              },
              {
                "uuid": "97e42d72-bdf4-46cf-8ca1-4ebc3b17c762",
                "control-id": "hipaa-164.312.a.1",
                "description": "Access Control: The Lambda execution role implements least privilege by scoping the IAM policy directly to required API actions and specific resource ARNs, eliminating wildcard permissions.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_iam_role_policy.lambda_intake"
                  }
                ]
              },
              {
                "uuid": "c9bc9e54-8c80-4cf8-8c10-0bf08871ab11",
                "control-id": "hipaa-164.312.b",
                "description": "Audit Controls: The API Gateway stage routes execution and access logs directly to a dedicated CloudWatch log group. It is further protected by an attached Web Application Firewall (WAF) to filter malicious traffic.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_api_gateway_stage.prod"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_wafv2_web_acl_association.api_waf_assoc"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}